items-center gap-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M-4.5,-4.5 H4.5 V4.5 H-4.5 Z" fill="var(--solid)" stroke="var(--solid-edge)" stroke-width="1"></path></svg> Solid</span><span class="flex flex-wrap items-baseline gap-x-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:solid:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span><span class="text-xs text-ink-2 italic">no tests recorded</span></span></li><li class="tile gap-1 px-3 py-2" data-empty="true"><span class="tile-label flex items-center gap-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M0,-5.8500000000000005 L5.8500000000000005,0 L0,5.8500000000000005 L-5.8500000000000005,0 Z" fill="var(--emulator)" stroke="var(--emulator-edge)" stroke-width="1"></path></svg> BRE emulator</span><span class="flex flex-wrap items-baseline gap-x-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:emulator:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span><span class="text-xs text-ink-2 italic">no tests recorded</span></span></li></ul></header><section class="px-5 pb-4" aria-labelledby="sec-gap" data-sheet-half=""><div class="raised relative py-2 pl-4 pr-3"><span class="hatch-bg absolute inset-y-0 left-0 w-2 rounded-l-lg border-r border-line" aria-hidden="true"></span><div class="flex items-center justify-between gap-2"><h2 id="sec-gap" class="eyebrow">What's missing</h2><button type="button" class="btn btn-sm btn-quiet -mr-2">Access gap chart</button></div><ul class="mt-1"><li class="tap-row flex items-baseline justify-between gap-3 py-1 text-sm "><span class="text-ink-2">Tests of any fuel class near this point</span><span class="flex-none tap-door text-sm font-semibold"><span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span></li><li class="pb-0.5 pt-1 text-xs text-ink-3 border-t border-line">Near this oxygen (within the step size), but no pressure recorded</li><li class="tap-row flex items-baseline justify-between gap-3 py-1 text-sm pl-3"><span class="text-ink-2">BRE sessions (chamber pressure)</span><span class="flex-none tap-door text-sm font-semibold"><span class="relative inline " data-prov="probe:1:o2match:emulator"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="16. Show where this number comes from">16</button></span></span></li><li class="tap-row flex items-baseline justify-between gap-3 py-1 text-sm pl-3"><span class="text-ink-2">Gas-flame tests</span><span class="flex-none tap-door text-sm font-semibold"><span class="relative inline " data-prov="probe:1:o2match:gas"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="20. Show where this number comes from">20</button></span></span></li><li class="tap-row flex items-baseline justify-between gap-3 py-1 text-sm border-t border-line"><span class="text-ink-2">No prebreathe figure for this point</span><span class="flex-none tap-door text-sm font-semibold"><a class="tap text-xs text-ink-2 underline underline-offset-2 hover:text-ink" href="/methods?open=prebreathe">Source</a></span></li><li class="tap-row flex items-baseline justify-between gap-3 py-1 text-sm border-t border-line"><span class="text-ink-2">Paper findings to verify, whole dataset</span><span class="flex-none tap-door text-sm font-semibold"><span class="relative inline " data-prov="gap:pending"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="63. Show where this number comes from">63</button></span></span></li></ul></div></section><section class="px-5 pb-4" aria-labelledby="sec-lines"><h2 id="sec-lines" class="eyebrow">Tests near, along each axis</h2><div class="mt-2 space-y-3"><div><div class="flex items-baseline justify-between gap-3 text-xs"><span class="text-ink-2">Along oxygen at <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="4 psi. Show where this number comes from">4 psi</button></span></span><span class="text-ink">at <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="40%. Show where this number comes from">40%</button></span>, <span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0 tests. Show where this number comes from">0 tests</button></span></span></div><div role="slider" tabindex="0" aria-label="Tests near points along oxygen at this pressure. Arrow keys move the cursor." aria-valuemin="0" aria-valuemax="170" aria-valuenow="50" aria-valuetext="at 40%, 0 tests near" class="relative mt-1 cursor-crosshair rounded-sm border-b border-line-strong" style="height:32px"><span class="hatch-bg absolute inset-y-0 opacity-60" style="left:0%;width:100%" aria-hidden="true"></span><svg class="absolute inset-0 h-full w-full" viewBox="0 0 171 32" preserveAspectRatio="none" aria-hidden="true"><path d="" fill="var(--ink-3)"></path></svg><span class="absolute -inset-y-1 -translate-x-1/2 bg-[color:var(--probe)]" style="left:29.53216374269006%;width:2px" aria-hidden="true"></span></div></div><div><div class="flex items-baseline justify-between gap-3 text-xs"><span class="text-ink-2">Along pressure at <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="40%. Show where this number comes from">40%</button></span> O2</span><span class="text-ink">at <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="4.0 psi. Show where this number comes from">4.0 psi</button></span>, <span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0 tests. Show where this number comes from">0 tests</button></span></span></div><div role="slider" tabindex="0" aria-label="Tests near points along pressure at this oxygen. Arrow keys move the cursor." aria-valuemin="0" aria-valuemax="140" aria-valuenow="10" aria-valuetext="at 4.0 psi, 0 tests near" class="relative mt-1 cursor-crosshair rounded-sm border-b border-line-strong" style="height:32px"><span class="hatch-bg absolute inset-y-0 opacity-60" style="left:0%;width:16.312056737588655%" aria-hidden="true"></span><svg class="absolute inset-0 h-full w-full" viewBox="0 0 141 32" preserveAspectRatio="none" aria-hidden="true"><path d="M23,32V30H24V32ZM24,32V30H25V32ZM25,32V30H26V32ZM26,32V30H27V32ZM27,32V29.166666666666668H28V32ZM28,32V29.166666666666668H29V32ZM29,32V29.166666666666668H30V32ZM30,32V29H31V32ZM31,32V29H32V32ZM32,32V29H33V32ZM33,32V28.833333333333332H34V32ZM34,32V28.666666666666668H35V32ZM35,32V28.666666666666668H36V32ZM36,32V28.666666666666668H37V32ZM37,32V28.6666