exports[`screens > brief exports: CSV and BibTeX 2`] = `
"@misc{redshift_dataset,
  title = {Redshift microgravity fire evidence dataset},
  note = {Project Redshift (2026). Redshift microgravity fire evidence dataset, version 2026-11-14+0817d1a144d2. Derived from NASA Physical Sciences Informatics (cite each investigation by its DOI).},
  version = {2026-11-14+0817d1a144d2}
}

@misc{PSI159,
  title = {Advanced Combustion via Microgravity Experiments / Cool Flames Investigation with Gases},
  howpublished = {NASA Physical Sciences Informatics},
  doi = {10.60555/cyt1-kh64},
  note = {PSI-159}
}

@misc{PSI69,
  title = {Flame Extinguishment Experiment},
  howpublished = {NASA Physical Sciences Informatics},
  doi = {10.60555/mbq8-0451},
  note = {PSI-69}
}
"
`;

exports[`screens > compare 1`] = `"<div><header class="mb-6 max-w-3xl"><span class="eyebrow">Compare atmospheres</span><h1 class="mt-2 text-xl font-semibold">What is known about fire at each atmosphere, side by side.</h1><p class="mt-2 text-sm text-ink-2">Columns are not ranked. Each shows the build&#x27;s counts at that point of the plane, at the same nearness step size. Empty means unknown, never safe.</p></header><div class="mb-4 flex flex-wrap items-center gap-2"><button type="button" class="chip h-8 text-xs" aria-pressed="true">14.7 psi / 21%</button><button type="button" class="chip h-8 text-xs" aria-pressed="true">10.2 psi / 26.5%</button><button type="button" class="chip h-8 text-xs" aria-pressed="false">10.2 psi / 30%</button><button type="button" class="chip h-8 text-xs" aria-pressed="true">8.2 psi / 34%</button><button type="button" class="chip h-8 text-xs" aria-pressed="false">4.3 psi / 100%</button><form class="flex gap-2"><label for="add-point" class="sr-only">Add a point, for example 30% 9 psi</label><input id="add-point" class="field field-sm w-48" placeholder="Add 30% 9 psi" value=""/><button type="submit" class="btn">Add</button></form><span class="seg ml-auto" role="group" aria-label="Nearness step size"><button type="button" aria-pressed="false">0.75x</button><button type="button" aria-pressed="true">1x</button><button type="button" aria-pressed="false">1.5x</button></span></div><div class="grid gap-px overflow-x-auto rounded-lg border border-line bg-[color:var(--line)]" style="grid-template-columns:repeat(3, minmax(260px, 1fr))"><section class="flex flex-col bg-[color:var(--surface-2)]" aria-label="Atmosphere 1"><header class="px-4 pb-4 pt-4"><div class="flex items-start justify-between gap-2"><span class="eyebrow">Low-pressure, high-oxygen candidate</span><button type="button" class="btn btn-sm btn-quiet" aria-label="Remove this column">Remove</button></div><p class="mt-2 text-lg font-semibold"><span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="34%. Show where this number comes from">34%</button></span> · <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="8.2 psi. Show where this number comes from">8.2 psi</button></span></p><p class="text-sm text-ink-2"><span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="56.5 kPa. Show where this number comes from">56.5 kPa</button></span></p><p class="mt-3 min-h-[48px] text-sm"><span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="40. Show where this number comes from">40</button></span> tests sit near this point. Solid material: <span class="relative inline " data-prov="probe:1:solid:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span> from PSI tables, <span class="relative inline " data-prov="probe:1:solid:published_paper"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="3. Show where this number comes from">3</button></span> from verified papers.</p></header><div class="border-t border-line px-4 py-4"><ul class="space-y-3" aria-label="Tests near this point by fuel class"><li class="grid grid-cols-[112px_1fr] items-center gap-3"><span class="flex items-center gap-2 text-sm text-ink-2"><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M4.5,0 A4.5,4.5 0 1,1 -4.5,0 A4.5,4.5 0 1,1 4.5,0" fill="var(--gas)" stroke="var(--gas-edge)" stroke-width="1"></path></svg> Gas flame</span><span class="relative flex h-6 items-center"><span class="bar fuel-bar fuel-gas absolute inset-y-0 left-0 rounded-sm" style="width:100%" aria-hidden="true"></span><span class="relative ml-auto flex items-baseline gap-2 rounded-sm bg-surface-2 px-2 text-sm"><span class="font-semibold"><span class="relative inline " data-prov="probe:1:gas:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="20. Show where this number comes from">20</button></span></span><span class="text-xs text-ink-3">paper <span class="relative inline " data-prov="probe:1:gas:published_paper"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:dec