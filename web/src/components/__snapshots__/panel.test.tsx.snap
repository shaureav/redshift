unded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="8.2 psi. Show where this number comes from">8.2 psi</button></span> <span class="text-base font-normal text-ink-2">(<span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="56.5 kPa. Show where this number comes from">56.5 kPa</button></span>)</span></h2><p class="text-sm text-ink-2">Low-pressure, high-oxygen candidate</p><p class="mt-2 text-sm" aria-live="polite"><span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="37. Show where this number comes from">37</button></span> tests sit near this point. None is a solid material.</p><ul class="mt-3 grid grid-cols-2 gap-2" aria-label="Tests near this point by fuel class"><li class="tile gap-1 px-3 py-2" data-empty="false"><span class="tile-label flex items-center gap-2 "><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M4.5,0 A4.5,4.5 0 1,1 -4.5,0 A4.5,4.5 0 1,1 4.5,0" fill="var(--gas)" stroke="var(--gas-edge)" stroke-width="1"></path></svg> Gas</span><span class="flex flex-wrap items-baseline gap-x-2 "><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:gas:psi_table"><button type="button" class="num rounded-sm underline