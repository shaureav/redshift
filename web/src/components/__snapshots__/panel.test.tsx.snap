transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span><span class="text-xs text-ink-2 italic">no tests recorded</span></span></li><li class="tile gap-1 px-3 py-2" data-empty="true"><span class="tile-label flex items-center gap-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M0,-5.8500000000000005 L5.8500000000000005,0 L0,5.8500000000000005 L-5.8500000000000005,0 Z" fill="var(--emulator)" stroke="var(--emulator-edge)" stroke-width="1"></path></svg> BRE emulator</span><span class="flex flex-wrap items-baseline gap-x-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:emulator:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span><span class="text-xs text-ink-2 italic">no tests recorded</span></span></li></ul></header><section class="px-5 pb-4" aria-labelledby="sec-gap"><div class="raised relative py-2 pl-4 pr-3"><span class="hatch-bg absolute inset-y-0 left-0 w-2 rounded-l-lg border-r border-line" aria-hidden="true"></span><div class="flex items-center justify-between gap-2"><h2 id="sec-gap" class="eyebrow">What&#x27;s missing</h2><button type="button" class="btn btn-sm btn-quiet -mr-2">Access gap chart</button></div><ul class="mt-1"><li class="flex items-baseline justify-between gap-3 py-1 text-sm "><span class="text-ink-2">Solid-material tests near this point</span><span class="flex-none text-sm font-semibold"><span class="relative inline " data-prov="probe:1:solid:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span></li><li class="pb-0.5 pt-1 text-xs text-ink-3 border-t border-line">At this oxygen, but no pressure recorded</li><li class="flex items-baseline justify-between gap-3 py-1 text-sm pl-3"><span class="text-ink-2">BRE sessions (chamber pressure)</span><span class="flex-none text-sm font-semibold"><span class="relative inline " data-prov="probe:1:o2match:emulator"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="16. Show where this number comes from">16</button></span></span></li><li class="flex items-baseline justify-between gap-3 py-1 text-sm pl-3"><span class="text-ink-2">Gas-flame tests</span><span class="flex-none text-sm font-semibold"><span class="relative inline " data-prov="probe:1:o2match:gas"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="20. Show where this number comes from">20</button></span></span></li><li class="flex items-baseline justify-between gap-3 py-1 text-sm border-t border-line"><span class="text-ink-2">Prebreathe figure awaits verification</span><span class="flex-none text-sm font-semibold"><a class="text-xs text-ink-2 underline underline-offset-2 hover:text-ink" href="/methods?open=prebreathe">Source</a></span></li><li class="flex items-baseline justify-between gap-3 py-1 text-sm border-t border-line"><span class="text-ink-2">Paper findings to verify, whole dataset</span><span class="flex-none text-sm font-semibold"><span class="relative inline " data-prov="gap:pending"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="63. Show where this number comes from">63</button></span></span></li></ul></div></section><section class="px-5 pb-4" aria-labelledby="sec-lines"><h2 id="sec-lines" class="eyebrow">Tests near, along each axis</h2><div class="mt-2 space-y-3"><div><div class="flex items-baseline justify-between gap-3 text-xs"><span class="text-ink-2">Along oxygen at <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="8.2 psi. Show where this number comes from">8.2 psi</button></span></span><span class="text-ink">at <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="34%. Show where this number comes from">34%</button></span>, <span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-color