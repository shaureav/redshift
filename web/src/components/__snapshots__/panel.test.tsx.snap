exports[`the instrument panel > matches its snapshot at sea, 4 psi and 40% O2 1`] = `"<div class="flex min-h-full flex-col" data-testid="evidence-panel"><header class="px-5 pb-4 pt-4"><div class="flex items-center justify-between gap-2"><span class="eyebrow">Probe</span></div><h2 class="mt-1 text-title num max-sm:text-heading"><span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="40%. Show where this number comes from">40%</button></span> <span class="text-ink-3">O2</span> · <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="4 psi. Show where this number comes from">4 psi</button></span> <span class="text-base font-normal text-ink-2">(<span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="27.6 kPa. Show where this number comes from">27.6 kPa</button></span>)</span></h2><p class="mt-3 text-body font-semibold text-ink lg:text-heading" aria-live="polite">No tests recorded near this point.</p><ul class="mt-3 grid grid-cols-2 gap-2 md:max-lg:grid-cols-4" aria-label="Tests near this point by fuel class" data-sheet-peek=""><li class="tile gap-1 px-3 py-2" data-empty="true"><span class="tile-label flex items-center gap-2 -mx-1 w-f