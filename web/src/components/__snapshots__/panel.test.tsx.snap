exports[`the instrument panel > matches its snapshot on a candidate, 8.2 psi and 34% O2 1`] = `"<div class="flex min-h-full flex-col" data-testid="evidence-panel"><header class="px-5 pb-4 pt-4"><div class="flex items-center justify-between gap-2"><span class="eyebrow">Candidate atmosphere</span></div><h2 class="mt-1 text-title num"><span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="34%. Show where this number comes from">34%</button></span> <span class="text-ink-3">O2</span> · <span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="8.2 psi. Show where this number comes from">8.2 psi</button></span> <span class="text-base font-normal text-ink-2">(<span class="relative inline " data-prov="probe:axes"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="56.5 kPa. Show where this number comes from">56.5 kPa</button></span>)</span></h2><p class="text-sm text-ink-2">Low-pressure, high-oxygen candidate</p><p class="mt-2 text-sm" aria-live="polite"><span class="relative inline " data-prov="probe:1:total"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="37. Show where this number comes from">37</button></span> tests sit near this point. None is a solid material.</p><ul class="mt-3 grid grid-cols-2 gap-2" aria-label="Tests near this point by fuel class"><li class="tile gap-1 px-3 py-2" data-empty="false"><span class="tile-label flex items-center gap-2 "><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M4.5,0 A4.5,4.5 0 1,1 -4.5,0 A4.5,4.5 0 1,1 4.5,0" fill="var(--gas)" stroke="var(--gas-edge)" stroke-width="1"></path></svg> Gas</span><span class="flex flex-wrap items-baseline gap-x-2 "><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:gas:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="20. Show where this number comes from">20</button></span></span><span class="text-xs text-ink-2 ">from PSI tables</span></span></li><li class="tile gap-1 px-3 py-2" data-empty="false"><span class="tile-label flex items-center gap-2 "><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M0,-5.175 L5.175,4.14 L-5.175,4.14 Z" fill="var(--droplet)" stroke="var(--droplet-edge)" stroke-width="1"></path></svg> Droplet</span><span class="flex flex-wrap items-baseline gap-x-2 "><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:droplet:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="17. Show where this number comes from">17</button></span></span><span class="text-xs text-ink-2 ">from PSI tables</span></span></li><li class="tile gap-1 px-3 py-2" data-empty="true"><span class="tile-label flex items-center gap-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M-4.5,-4.5 H4.5 V4.5 H-4.5 Z" fill="var(--solid)" stroke="var(--solid-edge)" stroke-width="1"></path></svg> Solid</span><span class="flex flex-wrap items-baseline gap-x-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:solid:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="0. Show where this number comes from">0</button></span></span><span class="text-xs text-ink-2 italic">no tests recorded</span></span></li><li class="tile gap-1 px-3 py-2" data-empty="true"><span class="tile-label flex items-center gap-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><svg width="12" height="12" viewBox="-6 -6 12 12" aria-hidden="true" class="inline-block align-[-2px]"><path d="M0,-5.8500000000000005 L5.8500000000000005,0 L0,5.8500000000000005 L-5.8500000000000005,0 Z" fill="var(--emulator)" stroke="var(--emulator-edge)" stroke-width="1"></path></svg> BRE emulator</span><span class="flex flex-wrap items-baseline gap-x-2 -mx-1 w-fit rounded-sm bg-[color:var(--surface-2)] px-1"><span class="tile-value swap-in"><span class="relative inline " data-prov="probe:1:emulator:psi_table"><button type="button" class="num rounded-sm underline decoration-dotted decoration-transparent underline-offset-[3px] transition-colors hover:decoration-[color