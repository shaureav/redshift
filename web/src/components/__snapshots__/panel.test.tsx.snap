tion-transparent underline-offset-[3px] transition-colors hover:decoration-[color:var(--ink-2)] focus-visible:decoration-[color:var(--ink-2)]  italic" aria-expanded="false" aria-haspopup="dialog" aria-label="37 tests. Show where this number comes from">37 tests</button></span></span></div><div role="slider" tabindex="0" aria-label="Tests near points along pressure at this oxygen. Arrow keys move the cursor." aria-valuemin="0" aria-valuemax="140" aria-valuenow="52" aria-valuetext="at 8.2 psi, 37 tests near" class="relative mt-1 cursor-crosshair rounded-sm border-b border-line-strong" style="height:32px"><span class="hatch-bg absolute inset-y-0 opacity-60" style="left:0%;width:16.312056737588655%" aria-hidden="true"></span><svg class="absolute inset-0 h-full w-full" viewBox="0 0 141 32" preserveAspectRatio="none" aria-hidden="true"><path d="M23,32V30H24V32ZM24,32V30H25V32ZM25,32V29.82383419689119H26V32ZM26,32V29.512953367875646H27V32ZM27,32V29.04663212435233H28V32ZM28,32V28.89119170984456H29V32ZM29,32V28.89119170984456H30V32ZM30,32V28.89119170984456H31V32ZM31,32V28.89119170984456H32V32ZM32,32V28.89119170984456H33V32ZM33,32V28.89119170984456H34V32ZM34,32V28.89119170984456H35V32ZM35,32V28.89119170984456H36V32ZM36,32V28.89119170984456H37V32ZM37,32V28.89119170984456H38V32ZM38,32V28.89119170984456H39V32ZM39,32V28.89119170984456H40V32ZM40,32V28.89119170984456H41V32ZM41,32V28.89119170984456H42V32ZM42,32V28.89119170984456H43V32ZM43,32V28.89119170984456H44V32ZM44,32V28.580310880829014H45V32ZM45,32V27.647668393782382H46V32ZM46,32V27.49222797927461H47V32ZM47,32V27.49222797927461H48V32ZM48,32V26.870466321243523H49V32ZM49,32V26.248704663212436H50V32ZM50,32V26.248704663212436H51V32ZM51,32V26.248704663212436H52V32ZM52,32V26.248704663212436H53V32ZM53,32V26.248704663212436H54V32ZM54,32V26.248704663212436H55V32ZM55,32V26.248704663212436H56V32ZM56,32V26.248704663212436H57V32ZM57,32V26.248704663212436H58V32ZM58,32V26.248704663212436H59V32ZM59,32V26.248704663212436H60V32ZM60,32V26.2487046