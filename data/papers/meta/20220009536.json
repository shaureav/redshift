ion":"Houston, Texas, United States"}},"id":"8132f50442ff42cdae0e235ed3d789a4","userType":"CONTRACTOR_GRANTEE","userId":"94b3a3048f4b4598891944abe5e0d86d"},{"organizationId":"30956d12b05c56f99ba04cefabd82400","sequence":3,"submissionId":20220009536,"meta":{"author":{"orcidId":"","name":"Patrick Estep"},"organization":{"name":"KBR (United States)","location":"Houston, Texas, United States"}},"id":"daabc9e0a46147cb8fd718589db56e16","userType":"CONTRACTOR_GRANTEE","userId":"c532ec4104e84d55a16b9412fd895c0e"},{"organizationId":"30956d12b05c56f99ba04cefabd82400","sequence":4,"submissionId":20220009536,"meta":{"author":{"orcidId":"","name":"Monica Hew"},"organization":{"name":"KBR (United States)","location":"Houston, Texas, United States"}},"id":"bf8dee7a64af40a38a2b463a5965ee44","userType":"CONTRACTOR_GRANTEE","userId":"8b2d6e220fd044a78c0e469b7121a131"},{"organizationId":"30956d12b05c56f99ba04cefabd82400","sequence":5,"submissionId":20220009536,"meta":{"author":{"orcidId":"","name":"Grant Harman"},"organization":{"name":"KBR (United States)","location":"Houston, Texas, United States"}},"id":"92b08334474f48a4a8e81d822a36a6e1","userType":"CONTRACTOR_GRANTEE","userId":"8264864e10ff497a98486f9d766e5881"},{"organizationId":"4c6a2b878d76521da887cdcb2564bf90","sequence":6,"submissionId":20220009536,"meta":{"author":{"orcidId":"","name":"Karina Marshall-Goebel"},"organization":{"name":"Johnson Space Center","location":"Houston, Texas, United States"}},"id":"509617fa54324cc9864daef09ec1600c","userType":"CIVIL","userId":"d306465b9b514ffa9c16d9c39c336ad2"},{"organizationId":"30956d12b05c56f99ba04cefabd82400","sequence":7,"submissionId":20220009536,"meta":{"author":{"orcidId":"","name":"Jason Norcross"},"organization":{"name":"KBR (United States)","location":"Houston, Texas, United States"}},"id":"6f99b0acd42247688dc997d78bb54cd5","userType":"CONTRACTOR_GRANTEE","userId":"3345addf91054a269a5d9c15495aff5c"},{"organizationId":"30956d12b05c56f99ba04cefabd82400","sequence":8,"submissionId":20220009536,"meta":{"author":{"orcidId":"","name":"Kadambari Suri"},"organization":{"name":"KBR (United States)","location":"Houston, Texas, United States"}},"id":"4c27c04500ae415e8e47eaf2827c2c48","userType":"CONTRACTOR_GRANTEE","userId":"0d50e3ee11d54b85b60426f6fbe939a3"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20220009536,"created":"2022-06-19T17:39:46.3135740+00:00","center":{"code":"JSC","name":"Johnson Space Center","id":"dd46994b91a94cb2a2722617cbbadc55"},"onlyAbstract":true,"sensitiveInformation":2,"abstract":"BACKGROUND: Apollo missions used a 100% O2 cabin atmosphere which effectively eliminated the risk of decompression sickness (DCS) during extravehicular activity (EVA) on the moon. NASA’s future missions to the moon and Mars are expected to use nitrox gas mixtures of up to 34% O2, 66% N2, which will reduce flammability risk compared with Apollo, but will necessitate Oxygen prebreathe prior to EVA to reduce DCS risk to acceptable levels. Prebreathe protocols used on the space shuttle and International Space Station are validated for microgravity EVAs, but the significantly increased risk of DCS during equivalent ambulatory EVAs make these protocols inapplicable to planetary EVA. An “exploration atmosphere” of 56.5 kPa (8.2 psia), 34% O2, 66% N2 has been recommended by NASA as a compromise that balances prebreathe duration, hypoxia, and flammability risk, assuming a 29.6 kPa (4.3 psi) spacesuit. However, this atmosphere may not be used for vehicles that do not support frequent EVA, and with commercial providers and international providers expected to provide landers, pressurized rovers, habitats, and spacesuits, different combinations of vehicle and spacesuit atmospheres are possible and will each require validated prebreathe protocols.  \n\nOVERVIEW: Key components of a multi-year strategic roadmap include: 1) Establish hypobaric chamber facility capable of supporting 8-person EVA prebreathe validation tests at saturation atmospheres up to 36% O2; 2) validate an EVA physical workload simulation for use during prebreathe validation testing; 3) validate the recommended “exploration atmosphere” prebreathe protocol; 4) validate prebreathe protocols for additional atmospheric combinations that bound the most likely potential operating ranges of future vehicles and spacesuits; and 5) update DCS risk estimation models based on results of prebreathe validation studies.  \n\nDISCUSSION: Details and data from completion of the first two steps of the strategic roadmap will be presented; the third step is currently underway, with pilot results provided in a companion presentation. Steps four and five will require a multi-year series of chamber tests; collaborations are being pursued.  ","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20220009536,"id":"bd482aca47764f90a8f2ea0b645a87c1"},"meetings":[{"country":"FR","submissionId":20220009536,"endDate":"2022-09-24T05:00:00.0000000+00:00","sponsors":[{"organizationId":"d0b811ba64ca502c8ec8636b127d210e","meta":{"organization":{"name":"Aerospace Medical Association","location":"Alexandria, Virginia, United States"}},"meetingId":"7bcd667467ad4adcaa9cf55a2ae391f7","id":"d0e6f3582bd24e1da7efd7dca4b2ef25"},{"meta":{"organization":{"name":"European Society of Aerospace Medicine (ESAM)"}},"meetingId":"7bcd667467ad4adcaa9cf55a2ae391f7","id":"3dce6107a73f432897000576f6a7a183"},{"meta":{"organization":{"name":"International Academy of Aviation and Space Medicine (IAASM)"}},"meetingId":"7bcd667467ad4adcaa9cf55a2ae391f7","id":"dd883d41264849be8671e719d591cdb2"},{"meta":{"organization":{"name":"French Society of Aviation and Space Medicine (SOFRAMAS)"}},"meetingId":"7bcd667467ad4adcaa9cf55a2ae391f7","id":"48921574f52b45038c9337ec3b0a2793"}],"name":"International Conference in Aerospace Medicine (ICAM2022)","location":"Paris","id":"7bcd667467ad4adcaa9cf55a2ae391f7","url":"https://www.icam2022.com/","startDate":"2022-09-22T05:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"ICAM_exploration_prebreathe_6-18-22.pdf","type":"ABSTRACT","links":{"original":"/api/citations/20220009536/downloads/ICAM_exploration_prebreathe_6-18-22.pdf","pdf":"/api/citations/20220009536/downloads/ICAM_exploration_prebreathe_6-18-22.pdf","fulltext":"/api/citations/20220009536/downloads/ICAM_exploration_prebreathe_6-18-22.pdf.txt"}}],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"}